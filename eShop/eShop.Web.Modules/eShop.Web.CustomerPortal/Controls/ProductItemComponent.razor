@using eShop.CoreBusiness.Models
@using Microsoft.AspNetCore.Components.Routing
<tr>
    <td>
        <NavLink href="@($"/product/{Product.ProductId}")">
            @Product.Name
        </NavLink>
    </td>

    <td>
        @Product.Brand
    </td>

    <td>
        @Product.Price.ToString("c")
    </td>
</tr>

@code {
    [Parameter]
    public Product Product { get; set; } = new Product();
}
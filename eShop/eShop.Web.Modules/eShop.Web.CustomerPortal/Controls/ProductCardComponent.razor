@using eShop.CoreBusiness.Models
@using Microsoft.AspNetCore.Components.Routing

<div class="card h-100">
    <div class="position-relative">
        <img src="@product.ImageLink" class="card-img-top" alt="@product.Name"/>
    </div>
    <div class="card-body d-flex flex-column">
        <h5 class="card-title mb-3">
            <NavLink Href="@($"product/{product.ProductId}")">@product.Name</NavLink>
        </h5>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            <span class="price-tag">@product.Price.ToString("c")</span>
            <NavLink Href="@($"product/{product.ProductId}")" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-eye"></i> View
            </NavLink>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Product product { get; set; }
}
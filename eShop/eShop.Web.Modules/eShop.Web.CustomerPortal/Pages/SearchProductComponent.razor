@page "/"
@using eShop.CoreBusiness.Models
@using eShop.UseCases.SearchProductScreen
@using eShop.Web.CustomerPortal.Controls
@inject ISearchProductUseCase searchProductUseCase

<div class="mb-5">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h3 class="mb-0 fw-bold"><i class="bi bi-stars text-warning"></i> Explore Products</h3>
            <p class="text-muted-custom mt-1">Find the best deals on premium items</p>
        </div>
        <div class="col-md-6">
            <div class="input-group shadow-sm border-0 rounded-3 overflow-hidden">
                <input type="text" class="form-control border-0 bg-white shadow-none" placeholder="Search for products..." @bind="filter" />
                <button class="btn btn-primary px-4" type="button" @onclick="HandleSearch">
                    <i class="bi bi-search"></i> Search
                </button>
            </div>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @if (products != null && products.Any())
        {
            foreach (var product in products)
            {
                <div class="col">
                    <ProductCardComponent product="@product"></ProductCardComponent>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="bi bi-box-seam text-muted" style="font-size: 3rem;"></i>
                <p class="mt-3 text-muted fs-5">No products found.</p>
            </div>
        }
    </div>
</div>

@code {
    private string filter = string.Empty;
    private IEnumerable<Product> products;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        products = searchProductUseCase.Execute(filter);
    }

    private void HandleSearch()
    {
        products = searchProductUseCase.Execute(filter);
    }
}
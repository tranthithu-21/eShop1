@page "/product/{id:int}"

@using eShop.CoreBusiness.Models
@using eShop.UseCases.ViewProductScreen.interfaces
@using eShop.UseCases.PluginInterfaces.UI

@inject IViewProductUseCase viewProduct
@inject IAddProductToCartUseCase addProductToCartUseCase
@inject NavigationManager navigationManager

<div class="container mt-5 mb-5">
    <div class="mb-4">
        <a href="/" class="btn btn-link text-decoration-none text-muted ps-0">
            <i class="bi bi-arrow-left"></i> Back to products
        </a>
    </div>

    @if (product is Product p)
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-5 bg-white p-5 d-flex align-items-center justify-content-center border-end">
                    <img src="@p.ImageLink" class="img-fluid" alt="@p.Name" style="max-height: 400px; object-fit: contain;" />
                </div>
                <div class="col-md-7">
                    <div class="card-body p-5 h-100 d-flex flex-column">
                        <div class="mb-2">
                            <span class="badge bg-primary rounded-pill px-3 py-2">@p.Brand</span>
                        </div>
                        <h2 class="card-title fw-bold mb-3 text-dark">
                            @p.Name
                        </h2>

                        <div class="mb-4">
                            <h3 class="price-tag fw-bold mb-0">@p.Price.ToString("c")</h3>
                        </div>

                        <div class="mb-4 flex-grow-1">
                            <h5 class="fw-semibold text-dark mb-3">Description</h5>
                            <p class="card-text text-muted" style="line-height: 1.7;">
                                @p.Description
                            </p>
                        </div>

                        <div class="mt-auto pt-4 border-top">
                            <button class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm" @onclick="AddToCart">
                                <i class="bi bi-cart-plus me-2"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
</div>

@code {

    private Product? product;

    [Parameter]
    public int Id { get; set; }

    protected override void OnParametersSet()
    {
        if (Id > 0)
        {
            product = viewProduct.Execute(Id);
        }
    }

    private void AddToCart()
    {
        if (product is Product p)
        {
            addProductToCartUseCase.Execute(p.ProductId);

            navigationManager.NavigateTo("/");
        }
    }
}
@page "/cart"
@using eShop.CoreBusiness.Models
@using eShop.UseCases.ShoppingCartScreen.interfaces
@using eShop.Web.CustomerPortal.Controls
@inject IViewShoppingCartUseCase viewShoppingCartUseCase

<div class="container mt-4 mb-5">
    <h3 class="fw-bold mb-4"><i class="bi bi-cart3 text-primary"></i> Shopping Cart</h3>

    @if (order != null && order.LineItems != null && order.LineItems.Count > 0)
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card p-4 shadow-sm border-0 rounded-4">
                    @foreach (var item in order.LineItems)
                    {
                        <LineItemComponent LineItem="item" OnItemUpdated="HandleItemUpdated"></LineItemComponent>
                        <hr class="my-4 text-muted" />
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 20px;">
                    <OrderSummaryComponent Order="order"></OrderSummaryComponent>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-muted">Your shopping cart is empty.</h4>
            <a href="/" class="btn btn-primary mt-3 px-4 rounded-pill">Continue Shopping</a>
        </div>
    }
</div>

@code {
    private Order order;

    protected override async Task OnInitializedAsync()
    {
        order = await viewShoppingCartUseCase.Execute();
    }

    private void HandleItemUpdated(Order newOrder)
    {
        order = newOrder;
    }
}

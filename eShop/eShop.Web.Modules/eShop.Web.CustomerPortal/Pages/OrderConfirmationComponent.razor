@page "/orderconfirm/{uniqueId}"

@using eShop.CoreBusiness.Models
@using eShop.UseCases.OrderConfirmationScreen.interfaces

@inject IViewOrderConfirmationUseCase viewOrderConfirmationUseCase

<div class="container mt-5 mb-5">
    @if (order != null)
    {
        <div class="text-center mb-5">
            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
            <h2 class="fw-bold mt-3">Thank you for your order!</h2>
            <p class="text-muted">Your order <span class="fw-bold text-dark">#@order.UniqueId.Substring(0, 8).ToUpper()</span> has been placed successfully.</p>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-lg-7">
                <div class="card p-4 shadow-sm border-0 rounded-4 h-100">
                    <h5 class="fw-bold mb-4 border-bottom pb-2"><i class="bi bi-geo-alt text-primary me-2"></i>Shipping Information</h5>
                    <div class="d-flex flex-column gap-2 text-muted">
                        <div class="fw-bold text-dark fs-5">@order.CustomerName</div>
                        <div><i class="bi bi-house me-2"></i>@order.CustomerAddress</div>
                        <div><i class="bi bi-building me-2"></i>@order.CustomerCity, @order.CustomerStateProvince</div>
                        <div><i class="bi bi-globe me-2"></i>@order.CustomerCountry</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <OrderSummaryComponent Order="order" HidePlaceOrderButton="true"></OrderSummaryComponent>
            </div>
        </div>
        
        <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-light border-0 py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-bag-check me-2 text-primary"></i>Order Details</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-borderless table-hover mb-0 align-middle">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Product</th>
                            <th class="py-3 text-center">Quantity</th>
                            <th class="pe-4 py-3 text-end">Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in order.LineItems)
                        {
                            <tr>
                                <td class="ps-4 py-3 fw-medium">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-white rounded p-1 me-3 shadow-sm border">
                                            <img src="@item.Product.ImageLink" alt="" style="width: 40px; height: 40px; object-fit: contain;" />
                                        </div>
                                        @item.Product.Name
                                    </div>
                                </td>
                                <td class="py-3 text-center text-muted">@item.Quantity</td>
                                <td class="pe-4 py-3 text-end fw-bold text-dark">@item.Price.ToString("c")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string UniqueId { get; set; }

    private Order order;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(UniqueId))
        {
            order = viewOrderConfirmationUseCase.Execute(UniqueId);
        }
    }
}

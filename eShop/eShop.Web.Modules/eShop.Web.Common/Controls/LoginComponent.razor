@using eShop.Web.Common.ViewModels
@inject NavigationManager NavigationManager

<EditForm Model="loginViewModel" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="name">User Name</label>
        <InputText id="name" @bind-Value="loginViewModel.UserName" class="form-control"></InputText>
    </div>
    
    <div class="form-group">
        <label for="password">Password</label>
        <InputText type="password" id="password" @bind-Value="loginViewModel.Password" class="form-control"></InputText>
    </div>

    <button class="btn btn-primary mt-2" type="submit">Login</button>
</EditForm>

@code {
    private LoginViewModel loginViewModel;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        loginViewModel = new LoginViewModel();
    }

    private void HandleValidSubmit()
    {
        NavigationManager.NavigateTo($"/authenticate?user={loginViewModel.UserName}&pwd={loginViewModel.Password}", true);
    }
}
